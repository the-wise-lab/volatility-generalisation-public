# Everything under data/ is ignored except the files committed on purpose:
# the behavioural data, the QC exclusion table and counts, the questionnaire
# data, and this directory's own documentation.
# This block stays last so that it overrides earlier rules such as *.zip.
data/*
!data/README.md
!data/behavioural_data.csv.zip
!data/questionnaire_data.csv.zip
!data/prepared/
data/prepared/*
!data/prepared/qc_exclusion_audit.csv
!data/prepared/qc_exclusion_counts.csv
